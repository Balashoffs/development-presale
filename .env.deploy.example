# Copy to .env.deploy and fill in real values. The file is gitignored.

# --- Required ---
VPS_HOST=user@203.0.113.10        # SSH target (or a Host alias from ~/.ssh/config)
VPS_PORT=8080                     # public host port to publish (HTTP)
CONSUMER_FOLDER=consumer_2        # which .consumer_env/<folder> to bake into the image

# --- Optional ---
SSH_PORT=22                       # SSH port if non-default
SSH_KEY=~/.ssh/id_ed25519         # path to private key, if not the default agent identity
SSH_OPTS=                         # extra raw ssh flags, e.g. "-o StrictHostKeyChecking=accept-new"

IMAGE_NAME=presale                # docker image name
CONTAINER_NAME=presale            # docker container name on the VPS
# IMAGE_TAG=                      # default: <git short SHA>, fallback "latest"
# RESTART_POLICY=unless-stopped

REMOTE_DIR=presale                # path on the VPS (relative to remote $HOME) for assets + uploads
