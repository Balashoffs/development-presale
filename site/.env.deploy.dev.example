# Скопируйте этот файл в корень проекта как `.env.deploy.dev` и заполните:
#   cp site/.env.deploy.dev.example .env.deploy.dev
# Файл .env.deploy.dev должен быть в .gitignore (секреты, IP сервера).
#
# Запуск:
#   ./deploy.sh --env=dev
#
# Что произойдёт:
#   - локальная сборка образа `konex-v3:dev-<sha>`;
#   - отправка по SSH на ${VPS_HOST};
#   - перезапуск контейнера `dev-example` на порту ${VPS_PORT}.
# Хост-nginx со server_name=${DEV_DOMAIN} проксирует
# https://${DEV_DOMAIN}/ → http://127.0.0.1:${VPS_PORT}.

# --- VPS-доступ (одинаковые значения для dev и prod, если сервер один) ---
VPS_HOST=user@vps.example.com
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519
# SSH_OPTS="-o StrictHostKeyChecking=accept-new"

# --- Порт контейнера на хосте (НЕ должен совпадать с prod) ---
VPS_PORT=8080

# Опционально — переопределить значения по умолчанию.
# По умолчанию имя контейнера = `dev-example`, image tag = `dev-<git-sha>`.
# CONTAINER_NAME=dev-example
# IMAGE_NAME=konex-v3
# IMAGE_TAG=dev-latest
# RESTART_POLICY=unless-stopped
