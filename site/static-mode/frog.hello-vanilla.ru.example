# Хостовый nginx server-блок для режима B (раздача статики напрямую).
# enable-site.sh заменит плейсхолдеры __DOMAIN__ и __WEBROOT__.
# certbot --nginx добавит listen 443 ssl и редирект 80 → 443.
#
# Правила кэширования / gzip — те же, что в корневом nginx.conf репозитория
# (внутри Docker-образа). Здесь они дублируются для статической раздачи.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    root __WEBROOT__;
    index index.html;
    absolute_redirect off;

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log  /var/log/nginx/__DOMAIN__.error.log;

    # ---- gzip ----
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        application/rss+xml
        application/atom+xml
        image/svg+xml
        font/woff
        font/woff2;

    # ---- /_astro/* — содержимое уже хешировано Astro, отдаём с 1-летним кешем ----
    location ~* ^/_astro/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ---- статические ассеты (картинки, шрифты, css/js без хеша) — 30 дней ----
    location ~* \.(?:css|js|woff2?|ttf|eot|otf|svg|jpg|jpeg|png|gif|webp|avif|ico)$ {
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # ---- HTML — must-revalidate, чтобы новый билд подхватился сразу ----
    location / {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        try_files $uri $uri/ $uri.html $uri/index.html =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
